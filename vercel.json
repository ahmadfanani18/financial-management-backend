{
  "version": 2,
  "builds": [
    {
      "src": "dist/vercel.js",
      "use": "@vercel/node",
      "config": {
        "runtime": "nodejs18.x",
        "includeFiles": "dist/**"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/dist/vercel.js"
    }
  ],
  "buildCommand": "pnpm build:vercel",
  "installCommand": "pnpm install"
}