generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum SubscriptionTier {
  FREE
  TRIAL
  PRO
}

enum AppType {
  FINANCIAL_MANAGEMENT
  EVENT_ORGANIZER
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  VA_BANK
  E_WALLET
  CREDIT_CARD
}

enum PaymentType {
  ONE_TIME
  SUBSCRIPTION
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PaymentProvider {
  BCA_VA
  BRI_VA
  BNI_VA
  MANDIRI_VA
  GOPAY
  OVO
  DANA
  CREDIT_CARD
}

enum AccountType {
  BANK
  EWALLET
  CASH
  CREDIT_CARD
  INVESTMENT
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  BUY
  SELL
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum BudgetPeriod {
  MONTHLY
  WEEKLY
  YEARLY
  CUSTOM
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GoalSource {
  MANUAL
  AUTO_GENERATED
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ReminderType {
  RECURRING
  ONE_TIME
}

enum BillAmountType {
  FIXED
  VARIABLE
}

enum BillMode {
  AUTO_DEDUCT
  REMINDER_ONLY
}

enum NotificationType {
  BUDGET_WARNING
  GOAL_MILESTONE
  PLAN_REMINDER
  ACCOUNT_ALERT
  DAILY_SUMMARY
  RECURRING_TRANSACTION
  REMINDER
  SYSTEM
  BILL_REMINDER
  BILL_SUCCESS
  BILL_FAILED
  BILL_OVERDUE
  BILL_AMOUNT_UPDATE
}

enum AssetType {
  CRYPTO
  US_STOCK
  IDX_STOCK
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  name                String
  password            String?
  avatar              String?
  role                UserRole         @default(MEMBER)
  subscriptionTier    SubscriptionTier @default(FREE)
  trialStartedAt      DateTime?
  trialEndsAt        DateTime?
  subscriptionStartAt DateTime?
  subscriptionEndAt   DateTime?
  lastReminderSentAt DateTime?
  preferences         Json             @default("{}")
  aiQuotaUsed         Int              @default(0) // Int is sufficient: max ~1000 req/day * 31 days = 31,000, well under 2^31-1
  aiQuotaResetAt      DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  emailVerifiedAt      DateTime?
  emailVerificationToken String?

  accounts            Account[]
  categories          Category[]
  tags                Tag[]
  transactions        Transaction[]
  budgets             Budget[]
  goals               Goal[]
  plans               Plan[]
  reminders           Reminder[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  payments            Payment[]
  subscriptions       Subscription[]
  conversations       Conversation[]
  feedback            Feedback[]
  bills               Bill[]
}

model MarketPrice {
  id        String   @id @default(uuid())
  symbol    String   @unique
  name      String
  type      AssetType
  price     String
  currency  String   @default("IDR")
  updatedAt DateTime @updatedAt

  @@index([symbol])
}

model Holding {
  id           String   @id @default(uuid())
  accountId    String
  symbol       String
  name         String?
  quantity     Decimal
  avgBuyPrice  Decimal
  assetType    AssetType @default(IDX_STOCK)
  realizedPnL  Decimal  @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  investmentTransactions InvestmentTransaction[]

  @@unique([accountId, symbol])
  @@index([accountId])
}

model InvestmentTransaction {
  id              String   @id @default(cuid())
  holdingId       String
  accountId       String
  type            TransactionType
  symbol          String
  quantity        Int
  pricePerShare   Decimal
  brokerFee       Decimal  @default(0)
  transactionDate DateTime
  createdAt       DateTime @default(now())

  holding Holding @relation(fields: [holdingId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id          String      @id @default(uuid())
  userId      String
  name        String
  accountNumber String?
  type        AccountType
  balance     String      @default("0")
  currency    String      @default("IDR")
  icon        String      @default("wallet")
  color       String      @default("#0EA5E9")
  isArchived  Boolean     @default(false)
  isLocked    Boolean     @default(false)
  lockedReason String?
  linkedGoalId String? @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]        @relation("AccountTransactions")
  fromTransfers         Transaction[]        @relation("FromTransfers")
  toTransfers           Transaction[]        @relation("ToTransfers")
  goalContributions     GoalContribution[]
  linkedGoal            Goal?                @relation("AccountToGoal", fields: [linkedGoalId], references: [id])
  holdings              Holding[]
  investmentTransactions InvestmentTransaction[]
  bills                 Bill[]
}

model Category {
  id          String       @id @default(uuid())
  userId      String
  name        String
  type        CategoryType
  icon        String       @default("tag")
  color       String       @default("#8B5CF6")
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions        Transaction[]
  budgets             Budget[]
  goalContributions   GoalContribution[]
  bills               Bill[]
}

model Tag {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#10B981")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]
}

model Transaction {
  id                String          @id @default(uuid())
  userId            String
  accountId         String
  categoryId        String?
  type              TransactionType
  amount            String
  adminFee          String          @default("0")
  description       String
  date              DateTime
  receiptUrl        String?
  fromAccountId     String?
  toAccountId       String?
  isRecurring       Boolean         @default(false)
  deductGoals        Boolean         @default(false)
  recurringPattern  Json?
  billId            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account         @relation("AccountTransactions", fields: [accountId], references: [id])
  category          Category?      @relation(fields: [categoryId], references: [id])
  fromAccount       Account?        @relation("FromTransfers", fields: [fromAccountId], references: [id])
  toAccount         Account?        @relation("ToTransfers", fields: [toAccountId], references: [id])
  bill              Bill?          @relation(fields: [billId], references: [id])
  tags              TransactionTag[]
  goalContributions GoalContribution[]
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model Budget {
  id                String       @id @default(uuid())
  userId            String
  categoryId        String
  amount            String
  spent             String       @default("0")
  period            BudgetPeriod @default(MONTHLY)
  startDate         DateTime
  endDate           DateTime?
  warningThreshold  Int          @default(80)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category     @relation(fields: [categoryId], references: [id])
  planBudgets       PlanBudget[]
}

model Bill {
  id             String        @id @default(uuid())
  userId         String
  name           String
  amount         String
  amountType     BillAmountType @default(FIXED)
  mode           BillMode       @default(AUTO_DEDUCT)
  dueDate        Int
  executionDate  Int
  accountId      String
  categoryId     String
  description    String?
  isActive       Boolean       @default(true)
  lastExecutedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  account       Account       @relation(fields: [accountId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  transactions  Transaction[]

  @@index([userId])
  @@index([executionDate])
  @@index([dueDate])
}

model Goal {
  id                String     @id @default(uuid())
  userId            String
  name              String
  targetAmount      String
  currentAmount     String     @default("0")
  deadline          DateTime
  icon              String     @default("target")
  color             String     @default("#10B981")
  status            GoalStatus @default(ACTIVE)
  isLocked          Boolean    @default(false)
  source            GoalSource @default(MANUAL)
  sourceMilestoneId String?
  linkedAccountId   String?
  initialBalance    String?
  isInitialSet      Boolean   @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions      GoalContribution[]
  planGoals          PlanGoal[]
  milestones         PlanMilestone[]
  linkedAccount      Account?  @relation("AccountToGoal")
}

enum ContributionType {
  MANUAL
  INITIAL
  AUTO
}

model GoalContribution {
  id          String          @id @default(uuid())
  goalId      String
  amount      String
  date        DateTime
  note        String?
  accountId   String?
  categoryId  String?
  type               ContributionType @default(MANUAL)
  sourceTransactionId String?
  createdAt          DateTime        @default(now())

  goal               Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  account            Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceTransaction  Transaction? @relation(fields: [sourceTransactionId], references: [id], onDelete: SetNull)
}

model Plan {
  id          String      @id @default(uuid())
  userId      String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  status      PlanStatus  @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  PlanMilestone[]
  planBudgets PlanBudget[]
  planGoals   PlanGoal[]
}

model PlanMilestone {
  id           String    @id @default(uuid())
  planId       String
  title        String
  description  String?
  targetDate   DateTime
  targetAmount String?
  goalId       String?
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  order        Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  plan         Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  goal         Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

model PlanBudget {
  planId    String
  budgetId  String

  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  budget    Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@id([planId, budgetId])
}

model PlanGoal {
  planId String
  goalId String

  plan   Plan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  goal   Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([planId, goalId])
}

model Reminder {
  id               String       @id @default(uuid())
  userId           String
  title            String
  description      String?
  type             ReminderType @default(ONE_TIME)
  date             DateTime
  recurrencePattern Json?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum FeedbackType {
  BUG
  SUGGESTION
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Feedback {
  id          String          @id @default(uuid())
  userId      String
  type        FeedbackType
  subject     String
  description String
  screenshot  String?
  status      FeedbackStatus  @default(OPEN)
  adminNote   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Pricing {
  id        String   @id @default(uuid())
  app       AppType
  amount    Int
  currency  String   @default("IDR")
  period    String   @default("MONTHLY")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([app, period])
}

model Coupon {
  id          String    @id @default(uuid())
  code        String    @unique
  description String?
  type        CouponType
  value       Int
  minPurchase Int?
  maxUses     Int?
  usedCount   Int       @default(0)
  validFrom   DateTime
  validUntil  DateTime
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments Payment[]
}

model Payment {
  id                     String         @id @default(uuid())
  userId                 String
  app                    AppType
  amount                 String
  finalAmount            String
  paymentMethod          PaymentMethod
  paymentProvider        PaymentProvider?
  paymentType            PaymentType
  midtransOrderId        String?
  midtransTransactionId  String?
  midtransToken          String?
  vaNumber               String?
  status                 PaymentStatus  @default(PENDING)
  errorMessage           String?
  callbackData           Json?
  couponId               String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  coupon       Coupon?       @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([midtransOrderId])
}

model Subscription {
  id                    String            @id @default(uuid())
  userId                String
  app                   AppType
  tier                  String            @default("PRO")
  startDate             DateTime
  endDate               DateTime
  autoRenewal           Boolean           @default(false)
  midtransSubscriptionId String?
  midtransTokenId       String?
  status                SubscriptionStatus @default(ACTIVE)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user    User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
