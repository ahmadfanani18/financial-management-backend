{
  "name": "financial-management-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx -e \"import('./src/index.ts').then(m => m.getApp());\"",
    "build": "prisma generate",
    "build:vercel": "node scripts/build-vercel.js",
    "postinstall": "prisma generate",
    "start": "node --import tsx src/index.ts",
    "start:vercel": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "migrate:encrypt": "tsx scripts/migrate-monetary-data.ts",
    "test": "vitest",
    "vc:build": "node scripts/build-vercel.js"
  },
  "vercel": {
    "builds": [
      {
        "src": "dist/index.js",
        "use": "@vercel/node"
      }
    ]
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^2.1.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "mailtrap": "^4.5.1",
    "nodemailer": "^8.0.7",
    "papaparse": "^5.5.3",
    "tsx": "^4.7.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.5.2",
    "@vercel/fastify": "^0.1.97",
    "esbuild": "^0.28.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
